DEBUG=True
SECRET_KEY=change-me-in-production-use-32-chars-minimum
DATABASE_URL=postgres://postgres:password@localhost:5432/freshDash
REDIS_URL=redis://localhost:6379/0
OTP_DEV_CODE=123456
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
CORS_ALLOW_ALL=True
API_RATE_LIMIT_PER_MINUTE=120

# Payments (optional — mock works without keys)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure this in Razorpay Dashboard → Webhooks. Used to verify the
# X-Razorpay-Signature header on incoming webhook POSTs.
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP (unset OTP_DEV_CODE in production and configure one provider)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Push (optional)
FCM_SERVER_KEY=
